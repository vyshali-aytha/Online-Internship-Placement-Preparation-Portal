# Required: API port. Defaults to 4000 if omitted.
PORT=4000

# Required: MySQL registration and OTP storage.
DB_HOST=localhost
DB_PORT=3306
DB_USER=<your-mysql-user>
DB_PASSWORD=<your-mysql-password>
DB_NAME=oipp

# Required: exact institutional email domains, comma-separated, without @.
INSTITUTION_EMAIL_DOMAINS=stu.pes.edu

# Required: at least 32 random characters. Generate a fresh local value; never commit it.
OTP_HMAC_SECRET=<generate-a-32-byte-random-base64-secret>

# Required: at least 32 random characters. Generate and keep this secret private.
JWT_SECRET=<generate-a-32-byte-random-base64-secret>

# Optional: JWT lifetime. Supports seconds or a duration such as 15m, 1h, or 1d.
JWT_EXPIRES_IN=1h

# Optional: temporary lockout duration after five failed login attempts.
LOGIN_LOCKOUT_MINUTES=15

# Required for OTP email delivery: institutional SMTP account and server.
SMTP_HOST=<smtp.example.edu>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<your-smtp-user>
SMTP_PASSWORD=<your-smtp-password>
SMTP_FROM=<portal@example.edu>
# Bootstrap administrator credentials.
# Store a bcrypt password hash, never the plaintext password.
# Configure these in your private .env/deployment environment.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
