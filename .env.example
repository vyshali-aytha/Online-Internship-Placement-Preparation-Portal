
# API server
PORT=4000

# MySQL database
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=oipp

# Allowed institutional email domains, comma-separated, without @
INSTITUTION_EMAIL_DOMAINS=stu.pes.edu

# Required secrets: generate unique values for your local .env
OTP_HMAC_SECRET=REPLACE_WITH_GENERATED_SECRET
JWT_SECRET=REPLACE_WITH_GENERATED_SECRET

# JWT lifetime
JWT_EXPIRES_IN=1h

# Lockout after failed login attempts
LOGIN_LOCKOUT_MINUTES=15

# SMTP configuration for OTP email delivery
SMTP_HOST=smtp.example.edu
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=portal@example.edu

# Bootstrap administrator credentials
# Use a bcrypt password hash, never a plaintext password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# HTTPS (OIPP-SR-001)
# Local: set ENABLE_HTTPS=true after running "npm run cert"
ENABLE_HTTPS=false
HTTPS_PORT=4443
# Deployed behind a proxy that provides the certificate: set to true
ENFORCE_HTTPS=false
# Optional real certificate paths
# TLS_KEY_PATH=
# TLS_CERT_PATH=